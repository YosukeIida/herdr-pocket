build/
.build/
*.xcodeproj/xcuserdata/
.DS_Store
Packages/HerdrKit/.build/

# Generated by XcodeGen (run `xcodegen generate`)
Herdr.xcodeproj/*
App/Info.plist
# Keep the resolved package versions, the one part of the generated project that is not derived from project.yml.
!Herdr.xcodeproj/project.xcworkspace/
Herdr.xcodeproj/project.xcworkspace/*
!Herdr.xcodeproj/project.xcworkspace/xcshareddata/
Herdr.xcodeproj/project.xcworkspace/xcshareddata/*
!Herdr.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
Herdr.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!Herdr.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
__pycache__/

# Your own signing, mods and host quirks
Config/Local.xcconfig
Config/mods.txt
Config/host-local.js
App/Resources/Mods/*
!App/Resources/Mods/_host.js

# Notes that mention real machines
docs/private/
.direnv/
